# MOSA Environment Configuration

# Neon Serverless PostgreSQL Database URL
# Example: postgresql://mosa_owner:xxxx@ep-cool-mountain-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mosa?schema=public"

# Production Edge JWT Secret Key for Session Authentication & RBAC Middleware
JWT_SECRET="mosa-production-secure-jwt-secret-key-rwanda-2026"

# Optional Google Gemini Vision AI key for deep handwriting receipt structuring
GEMINI_API_KEY=""

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
