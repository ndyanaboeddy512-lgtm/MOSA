# MOSA Environment Configuration
# All values are optional for initial local evaluation / demo mode.

# Serverless Database URL (PostgreSQL / Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/mosa?schema=public"

# Optional Google Gemini Vision AI key for deep handwriting receipt structuring
# If omitted, MOSA automatically uses its built-in heuristic pattern extractor.
GEMINI_API_KEY=""

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
