// MOSA Database Schema
// Scalable relational architecture supporting PostgreSQL / Neon / Supabase

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMUNITY_ADMIN
  COMMUNITY_AGENT
  BUSINESS_OWNER
  CUSTOMER
  MODERATOR
}

enum VerificationStatus {
  UNVERIFIED
  AGENT_VERIFIED
  COMMUNITY_VERIFIED
  BUSINESS_VERIFIED
  HIGH_CONFIDENCE
}

enum LocationSource {
  GPS_DEVICE
  AGENT_PIN
  MAP_SELECTION
  ADMIN_MANUAL
  OWNER_REPORTED
}

enum LocationVerificationStatus {
  UNVERIFIED
  AGENT_CAPTURED
  AGENT_VERIFIED
  COMMUNITY_VERIFIED
  BUSINESS_CONFIRMED
}

enum DataStatus {
  DEMO
  RESEARCHED
  VERIFIED
}

enum PriceType {
  FIXED
  ESTIMATED
  RANGE
}

enum DocumentType {
  RECEIPT
  MENU
  PRICE_BOARD
  STOREFRONT_SIGN
}

enum ExtractionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ReportReason {
  FAKE_BUSINESS
  WRONG_PRICE
  CLOSED_PERMANENTLY
  WRONG_LOCATION
  SPAM
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id              String         @id @default(cuid())
  phone           String         @unique
  name            String
  passwordHash    String?
  role            Role           @default(CUSTOMER)
  language        String         @default("rw") // rw, en, fr, sw
  community       String?
  assignedCell    String?
  points          Int            @default(0)
  badges          String[]       @default([])
  referralCode    String         @unique
  referredById    String?
  status          String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  businessesOwned  Business[]        @relation("OwnerBusinesses")
  businessesAgent  Business[]        @relation("AgentBusinesses")
  captures         ReceiptCapture[]
  verifications    VerificationRecord[]
  reviews          Review[]
  reports          Report[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  sessions         Session[]
  claims           BusinessClaim[]
  agentAssignments AgentAssignment[]
  changeHistories  BusinessChangeHistory[]
  locationsCaptured Business[]        @relation("LocationCapturedBy")
  locationsVerified Business[]        @relation("LocationVerifiedBy")

  @@index([phone])
  @@index([role])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model OtpVerification {
  id           String    @id @default(cuid())
  phone        String
  code         String
  attempts     Int       @default(0)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@index([createdAt])
}

// 7-Tier Geographic Hierarchy Models for Rwanda & Regional Expansion

model GeographicProvince {
  id        String   @id @default(cuid())
  code      String   @unique // "KIGALI", "NORTH", "SOUTH", "EAST", "WEST"
  name      String   // "City of Kigali", "Northern Province", etc.
  nameRw    String   // "Umujyi wa Kigali", "Intara y'Amajyaruguru", etc.
  createdAt DateTime @default(now())

  districts  GeographicDistrict[]
  businesses Business[]
}

model GeographicDistrict {
  id         String   @id @default(cuid())
  code       String   @unique // "GASABO", "NYARUGENGE", "KICUKIRO", "MUSANZE", etc.
  provinceId String
  province   GeographicProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String   // "Gasabo", "Nyarugenge", "Musanze", etc.
  nameRw     String
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())

  sectors    GeographicSector[]
  businesses Business[]

  @@index([provinceId])
}

model GeographicSector {
  id          String   @id @default(cuid())
  code        String   @unique // "KACYIRU", "NYAMIRAMBO", "MUHOZA", etc.
  districtId  String
  districtRel GeographicDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name        String   // "Kacyiru", "Nyamirambo"
  nameRw      String
  latitude    Float
  longitude   Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  cells       GeographicCell[]
  localAreas  LocalArea[]
  businesses  Business[]
  agents      AgentAssignment[]
  demands     CommunityDemand[]

  @@index([districtId])
}

model GeographicCell {
  id        String   @id @default(cuid())
  sectorId  String
  sectorRel GeographicSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name      String   // "Kamutwa", "Kibaza", "Kamatamu", "Biryogo", etc.
  nameRw    String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  localAreas LocalArea[]
  businesses Business[]
  agents     AgentAssignment[]

  @@unique([sectorId, name])
  @@index([sectorId])
}

model LocalArea {
  id          String   @id @default(cuid())
  sectorId    String
  sectorRel   GeographicSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  cellId      String?
  cellRel     GeographicCell?  @relation(fields: [cellId], references: [id], onDelete: SetNull)
  name        String   // "MINAGRI Area", "Biryogo Car-Free Zone", "Cosmos Commercial Strip"
  nameRw      String
  type        String   @default("LOCALITY") // "LOCALITY", "LANDMARK", "MARKET", "CORRIDOR"
  landmark    String?  // "Ministry of Agriculture and Animal Resources (KG 569 St)"
  addressNote String?  // "KG 569 St, near MINAGRI HQ"
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  businesses  Business[]

  @@index([sectorId])
  @@index([cellId])
}

model AgentAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectorId   String
  sectorRel  GeographicSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  cellId     String?
  cellRel    GeographicCell?  @relation(fields: [cellId], references: [id], onDelete: SetNull)
  assignedAt DateTime @default(now())
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE

  @@index([userId])
  @@index([sectorId])
  @@index([cellId])
}

// Backwards-compatible Community model for pilot queries
model Community {
  id           String      @id @default(cuid())
  name         String
  nameRw       String
  country      String      @default("Rwanda")
  province     String      // Kigali City
  district     String      // Nyarugenge
  sector       String      // Nyamirambo
  cell         String      // Biryogo
  latitude     Float
  longitude    Float
  createdAt    DateTime    @default(now())

  businesses   Business[]
  demands      CommunityDemand[]

  @@index([cell])
  @@index([sector])
}

model Business {
  id                 String             @id @default(cuid())
  name               String
  nameRw             String?
  nameFr             String?
  nameSw             String?
  category           String
  categoryDisplay    String             @default("General")
  categoryDisplayRw  String             @default("Rusange")
  description        String
  descriptionRw      String?
  descriptionFr      String?
  descriptionSw      String?
  phone              String
  whatsapp           String?
  
  // Data Lifecycle Status
  dataStatus         DataStatus         @default(DEMO)
  source             String             @default("SAMPLE_SEED") // SAMPLE_SEED, AGENT_FIELD_AUDIT, OWNER_REGISTRATION
  priceRangeMin      Float?
  priceRangeMax      Float?
  lastVerifiedAt     DateTime?

  // Legacy Community link for backwards compatibility
  communityId        String?
  community          Community?         @relation(fields: [communityId], references: [id])
  
  // Relational Geographic Foreign Keys
  provinceId         String?
  provinceRel        GeographicProvince? @relation(fields: [provinceId], references: [id])
  districtId         String?
  districtRel        GeographicDistrict? @relation(fields: [districtId], references: [id])
  sectorId           String?
  sectorRel          GeographicSector?   @relation(fields: [sectorId], references: [id])
  cellId             String?
  cellRel            GeographicCell?     @relation(fields: [cellId], references: [id])
  localAreaId        String?
  localArea          LocalArea?          @relation(fields: [localAreaId], references: [id])

  // Denormalized strings for rapid filtering and backwards compatibility
  cell               String             @default("Biryogo")
  sector             String             @default("Nyamirambo")
  district           String             @default("Nyarugenge")
  addressNote        String?
  latitude           Float
  longitude          Float
  verificationStatus VerificationStatus @default(UNVERIFIED)

  // Micro-Business Smart Location & Ground Discovery
  nearestLandmark             String?
  streetName                  String?
  nearbyPlace                 String?
  locationDescription         String?
  locationSource              LocationSource             @default(ADMIN_MANUAL)
  locationAccuracy            Float?
  locationVerificationStatus  LocationVerificationStatus @default(UNVERIFIED)
  locationCapturedById        String?
  locationCapturedBy          User?                      @relation("LocationCapturedBy", fields: [locationCapturedById], references: [id])
  locationCapturedAt          DateTime?
  locationVerifiedById        String?
  locationVerifiedBy          User?                      @relation("LocationVerifiedBy", fields: [locationVerifiedById], references: [id])
  locationVerifiedAt          DateTime?

  isOpenNow          Boolean            @default(true)
  coverImage         String?
  priceRange         String             @default("MODERATE")
  status             String             @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  viewsCount         Int                @default(0)
  contactClicksCount Int                @default(0)
  searchCount        Int                @default(0)
  
  ownerId            String?
  owner              User?              @relation("OwnerBusinesses", fields: [ownerId], references: [id])
  agentId            String?
  agent              User?              @relation("AgentBusinesses", fields: [agentId], references: [id])
  
  // Business Operational & Keep-Alive Metadata
  subCategory        String?
  lastConfirmedAt    DateTime?
  confirmationIntervalDays Int          @default(60)
  healthScore        Int                @default(0)
  claimedAt          DateTime?
  claimPhone         String?
  isClaimed          Boolean            @default(false)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  businessHours      BusinessHour[]
  media              BusinessMedia[]
  captures           ReceiptCapture[]
  verifications      VerificationRecord[]
  reviews            Review[]
  reports            Report[]
  offers             Offer[]
  claims             BusinessClaim[]
  viewEvents         BusinessViewEvent[]
  changeHistory      BusinessChangeHistory[]
  reminders          BusinessReminder[]
  smsMessages        SMSMessage[]

  @@index([category])
  @@index([cell])
  @@index([sector])
  @@index([sectorId])
  @@index([cellId])
  @@index([dataStatus])
  @@index([verificationStatus])
  @@index([locationVerificationStatus])
  @@index([status])
  @@index([updatedAt])
  @@index([isOpenNow])
  @@index([isClaimed])
  @@index([lastConfirmedAt])
}

model BusinessClaim {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimPhone         String
  ownerName          String?
  nationalIdOrDoc    String?
  verificationNotes  String?
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy         String?
  reviewedAt         DateTime?
  claimedAt          DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
  @@index([status])
}

model Product {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  nameRw          String?
  nameFr          String?
  nameSw          String?
  description     String?
  price           Float
  priceMin        Float?
  priceMax        Float?
  priceType       PriceType     @default(FIXED)
  currency        String        @default("RWF")
  unit            String?       @default("item")
  isAvailable     Boolean       @default(true)
  isEstimated     Boolean       @default(false)
  sortOrder       Int           @default(0)
  isArchived      Boolean       @default(false)
  category        String?
  dataStatus      DataStatus    @default(DEMO)
  extractedFrom   DocumentType?
  confidenceScore Float?
  verifiedByAgent Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  receiptItemId   String?       @unique
  receiptItem     ReceiptItem?  @relation(fields: [receiptItemId], references: [id])
  changeHistory   BusinessChangeHistory[]

  @@index([businessId])
  @@index([category])
  @@index([dataStatus])
  @@index([isArchived])
}

model BusinessHour {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  day         String
  dayRw       String
  open        String
  close       String
  isClosed    Boolean   @default(false)

  @@index([businessId])
}

model BusinessMedia {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  isCover     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

model ReceiptCapture {
  id               String           @id @default(cuid())
  businessId       String?
  business         Business?        @relation(fields: [businessId], references: [id])
  agentId          String
  agent            User             @relation(fields: [agentId], references: [id])
  documentType     DocumentType     @default(RECEIPT)
  imageUrl         String
  rawOcrText       String?
  merchantDetected String?
  dateDetected     String?
  totalAmount      Float?
  currency         String           @default("RWF")
  status           ExtractionStatus @default(PENDING_VERIFICATION)
  sanitized        Boolean          @default(true)
  uploadedAt       DateTime         @default(now())
  verifiedAt       DateTime?

  items            ReceiptItem[]

  @@index([agentId])
  @@index([businessId])
  @@index([status])
}

model ReceiptItem {
  id           String          @id @default(cuid())
  captureId    String
  capture      ReceiptCapture  @relation(fields: [captureId], references: [id], onDelete: Cascade)
  name         String
  price        Float
  quantity     Float           @default(1)
  category     String?
  confidence   Float           @default(0.9)
  
  product      Product?

  @@index([captureId])
}

model VerificationRecord {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  type        String    // AGENT_AUDIT, LOCATION_GPS, COMMUNITY_CONFIRMATION, OWNER_CLAIM
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
}

model Review {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  rating        Int
  comment       String
  commentRw     String?
  verifiedVisit Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
}

model Report {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  reason      ReportReason
  details     String
  status      ReportStatus  @default(OPEN)
  createdAt   DateTime      @default(now())

  @@index([businessId])
  @@index([status])
}

model Offer {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  titleRw     String
  description String?
  descriptionRw String?
  discount    String
  startDate   DateTime  @default(now())
  validUntil  DateTime
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED, DRAFT
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([status])
}

model Mission {
  id          String    @id @default(cuid())
  title       String
  titleRw     String
  description String
  descriptionRw String
  targetArea  String
  pointsReward Int
  badgeReward String?
  category    String
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([targetArea])
}

model CommunityDemand {
  id                    String            @id @default(cuid())
  communityId           String?
  community             Community?        @relation(fields: [communityId], references: [id])
  sectorId              String?
  sectorRel             GeographicSector? @relation(fields: [sectorId], references: [id])
  sector                String
  cell                  String
  category              String
  queryTerm             String
  queryTermRw           String?
  searchCount           Int               @default(1)
  activeBusinessesCount Int               @default(0)
  opportunityScore      String            @default("HIGH")
  updatedAt             DateTime          @updatedAt

  @@index([cell])
  @@index([sector])
  @@index([opportunityScore])
}

model SearchEvent {
  id           String    @id @default(cuid())
  query        String
  sector       String?
  cell         String?
  resultsCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

model BusinessViewEvent {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referrer    String?
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    String?   // JSON representation of changes/context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model BusinessChangeHistory {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?     @relation(fields: [actorId], references: [id])
  action         String    // PRICE_CHANGED, PROFILE_UPDATED, PRODUCT_ADDED, PRODUCT_EDITED, PRODUCT_ARCHIVED, HOURS_UPDATED, OFFER_CREATED, CONFIRMATION_SUBMITTED
  fieldChanged   String?
  previousValue  String?
  newValue       String?
  approvalStatus String    @default("APPROVED") // PENDING, VALIDATED, APPROVED, REJECTED
  source         String    @default("OWNER_DASHBOARD") // OWNER_DASHBOARD, COMMAND_CENTER, AGENT_AUDIT, AUTO_RULE
  metadata       String?   // JSON representation of additional context
  createdAt      DateTime  @default(now())

  @@index([businessId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model BusinessReminder {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        String    // CONFIRMATION_DUE, HOURS_MISSING, PRICES_MISSING, DEMAND_SURGE, INCOMPLETE_PROFILE, LOCATION_UNVERIFIED
  title       String
  titleRw     String
  message     String
  messageRw   String
  severity    String    @default("INFO") // INFO, WARNING, URGENT
  actionUrl   String?
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([type])
  @@index([isResolved])
}

model SMSMessage {
  id                 String    @id @default(cuid())
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  recipientPhone     String
  templateId         String    // UPDATE_SUCCESS, REMINDER, SECURITY_ALERT, PROFILE_CONFIRMATION, DEMAND_ALERT
  language           String    @default("rw") // rw, en, fr, sw
  messageBody        String
  provider           String    @default("UNCONFIGURED") // AFRICAS_TALKING, TWILIO, PINPOINT, UNCONFIGURED
  status             String    @default("CONFIGURATION_REQUIRED") // CONFIGURATION_REQUIRED, PENDING, SENT, DELIVERED, FAILED
  providerMessageId  String?
  errorMessage       String?
  retryCount         Int       @default(0)
  sentAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([businessId])
  @@index([recipientPhone])
  @@index([status])
  @@index([createdAt])
}

